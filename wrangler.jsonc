{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "polis-serverless",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/c/*", "/r/*", "/a/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION",
        "class_name": "Conversation"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Conversation"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    }
  }
  // 正式網域（例如 polis.mashbean.net）決定後，比照 delib 的做法放進 env.production 的
  // routes: [{ "pattern": "...", "custom_domain": true }]，避免 Deploy Button 複製者搶走網域。
}
