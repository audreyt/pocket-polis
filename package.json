{
  "name": "@mashbean/pocket-polis",
  "version": "0.1.0",
  "description": "Pocket Polis (口袋審議): a lightweight Polis, designed and deployable in one step by AI agents — a complete wikisurvey round on a single Cloudflare Worker, no server to host",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashbean/pocket-polis.git"
  },
  "bugs": "https://github.com/mashbean/pocket-polis/issues",
  "homepage": "https://polis.tw/",
  "bin": {
    "pocket-polis": "./scripts/cli.mjs"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/ensure-queue.mjs && wrangler deploy",
    "deploy:production": "node scripts/ensure-queue.mjs && wrangler deploy --env production",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run deploy:dry"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
